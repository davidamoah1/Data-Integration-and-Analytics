# ─── Production Environment ─────────────────────────────────────
# Copy to .env.prod and set ALL values before deploying.
# NEVER commit the actual .env.prod file with real credentials.

# Application
APP_ENV=production
LOG_LEVEL=INFO

# Database — MySQL required for production
DB_TYPE=mysql
MYSQL_HOST=your-prod-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=aedip_prod
MYSQL_USER=aedip_prod
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Connection Pool — tuned for production load
POOL_SIZE=20
POOL_TIMEOUT=30
POOL_RECYCLE=3600
MAX_OVERFLOW=40

# Redis — required for caching and background jobs in production
REDIS_URL=redis://your-redis-host:6379/0
CACHE_ENABLED=true

# Security — MUST be set to a strong, unique secret (min 32 chars)
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
# Separate encryption key for Fernet (API keys, sensitive data)
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# File Storage — object storage required for production
# Choose one: r2, s3, supabase (local is rejected in production unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=1)
STORAGE_BACKEND=r2

# Cloudflare R2
R2_BUCKET=aedip-prod-files
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_PUBLIC_URL=https://files.yourdomain.com

# AWS S3 (alternative)
# S3_BUCKET=aedip-prod-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Supabase (alternative)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_STORAGE_BUCKET=files

# CORS — explicitly list allowed origins
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# MFA
MFA_ENABLED=true

# SSO (optional)
SSO_ENABLED=false

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Demo data — never in production
SEED_DEMO_DATA=false

# ── Phase 18: Production Monitoring ──────────────────
# Sentry error tracking (leave empty to disable)
SENTRY_DSN=https://your-key@sentry.io/your-project
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=aedip@1.0.0

# OpenTelemetry tracing (leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example.com
OTEL_SERVICE_NAME=aedip-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_METRIC_EXPORT_INTERVAL=60000

# Prometheus metrics (always enabled)
PROMETHEUS_ENABLED=true
MONITORING_ENABLED=true

# Structured JSON logging for production
LOG_FORMAT=json
LOG_LEVEL=INFO
