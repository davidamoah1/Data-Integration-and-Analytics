# ──────────────────────────────────────────────
# ETL Project Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Application environment: development | testing | production
APP_ENV=production

# Data paths (relative to project root)
# Production: set RAW_DATA_PATH to your actual data file. No default sample data.
RAW_DATA_PATH=
PROCESSED_DATA_PATH=data/processed/cleaned_data.csv

# Demo / onboarding data — opt-in only. Set to true for pilot/demo deployments.
# Production MUST keep this set to false.
SEED_DEMO_DATA=false
DEMO_DATASETS_DIR=demo_datasets

# Super admin credentials (configure for production — no hardcoded defaults)
SUPER_ADMIN_EMAIL=admin@dataflow.io
SUPER_ADMIN_PASSWORD=change-this-in-production

# Database
# Production deployments MUST use DB_TYPE=mysql. SQLite is only for local development/testing.
# Option 1: Use DATABASE_URL for a complete connection string (takes precedence)
# Example: mysql+pymysql://aedip_user:password@localhost:3306/aedip?charset=utf8mb4
DATABASE_URL=
# Option 2: Use individual MySQL connection vars (used when DATABASE_URL is empty)
DB_TYPE=mysql
# MySQL connection (required when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aedip
MYSQL_USER=aedip_user
MYSQL_PASSWORD=change-me-in-production
# Connection pool settings (MySQL only)
POOL_SIZE=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600
MAX_OVERFLOW=20
# SQLite path (only used when DB_TYPE=sqlite)
SQLITE_DB_PATH=database/etl_database.db

# Logging
LOG_PATH=logs/pipeline.log
LOG_LEVEL=INFO
# LOG_FORMAT=text   # set to 'json' for structured JSON logs

# Scheduler
PIPELINE_RUN_TIME=08:00

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-this-in-production
# CORS_ORIGINS must not be '*' in production. Separate multiple origins with commas.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# Rate limiting (requests per minute per client IP)
RATE_LIMIT_RPM=120

# Dashboard Authentication (env-var-based — no hardcoded default users)
AUTH_ADMIN_PASSWORD=
AUTH_VIEWER_PASSWORD=

# ──────────────────────────────────────────────
# Phase 4 — Enterprise IAM Security Settings
# ──────────────────────────────────────────────

# JWT Configuration
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Encryption Key (separate from JWT for API key/secret encryption)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# MFA Configuration (future-ready — set MFA_ENABLED=true to enable)
MFA_ENABLED=false
MFA_ISSUER=DataFlow

# SSO Configuration (future-ready — set SSO_ENABLED=true to enable)
SSO_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_SAML_ENTITY_ID=
SSO_SAML_ACS_URL=

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5

# Account Lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ──────────────────────────────────────────────
# Phase 6 — AI Intelligence Platform
# ──────────────────────────────────────────────

# Default AI Provider (openai, gemini, deepseek, glm, claude, local)
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=60

# Provider API Keys (leave empty to disable)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
CLAUDE_API_KEY=

# Provider Base URLs (override for proxies/self-hosted)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CLAUDE_BASE_URL=https://api.anthropic.com/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# AI Memory & Cache
AI_MEMORY_MAX_MESSAGES=20
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600

# AI Security
AI_ENFORCE_PERMISSIONS=true
AI_MAX_INPUT_LENGTH=10000
AI_DATA_RETENTION_DAYS=90

# AI Usage Limits
AI_DAILY_TOKEN_LIMIT=1000000
AI_MONTHLY_COST_LIMIT_USD=100.0

# AI Document Chat
AI_DOC_MAX_SIZE_MB=20
AI_DOC_ALLOWED_TYPES=pdf,docx,xlsx,csv,pptx,txt

# AI Forecasting
AI_FORECAST_CONFIDENCE_LEVEL=0.95
AI_FORECAST_MAX_HORIZON=365

# AI Anomaly Detection
AI_ANOMALY_SENSITIVITY=2.0
AI_ANOMALY_MIN_DATA_POINTS=10

# ──────────────────────────────────────────────
# Production Infrastructure
# ──────────────────────────────────────────────

# Redis (used for distributed caching, rate limiting, and session state in production)
REDIS_URL=redis://localhost:6379/0

# Backup configuration
# Backups are written to this directory (absolute or relative to project root)
BACKUP_PATH=backups
# Optional: S3-compatible object storage for off-site backups
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_BUCKET=aedip-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# ──────────────────────────────────────────────
# Notifications
# ──────────────────────────────────────────────

# SMTP (required for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# SMS provider (twilio, messagebird, etc.)
SMS_PROVIDER=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business provider
WHATSAPP_PROVIDER=
WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Push notifications (firebase, onesignal, etc.)
PUSH_PROVIDER=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_KEY=
