# ─── Development Environment ─────────────────────────────────────
# Copy to .env.dev and adjust as needed

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Database — SQLite for local development (zero setup)
DB_TYPE=sqlite
SQLITE_DB_PATH=database/dev_database.db

# Alternative: MySQL for dev (uncomment if preferred)
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=aedip_dev
# MYSQL_USER=aedip_dev
# MYSQL_PASSWORD=dev_password_here

# Connection Pool (ignored for SQLite)
POOL_SIZE=5
POOL_TIMEOUT=10
POOL_RECYCLE=1800
MAX_OVERFLOW=10

# Redis (optional for dev — caching disabled if empty)
REDIS_URL=

# Security — dev can use default secret
JWT_SECRET_KEY=dev-only-secret-key-not-for-production-use-32chars

# File Storage — local filesystem for dev
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/files

# Demo data
SEED_DEMO_DATA=true
