# ─── Testing Environment ────────────────────────────────────────
# Copy to .env.test and adjust as needed

# Application
APP_ENV=testing
LOG_LEVEL=WARNING

# Database — in-memory SQLite for fast, isolated test runs
DB_TYPE=sqlite
SQLITE_DB_PATH=database/test_database.db

# Connection Pool (ignored for SQLite)
POOL_SIZE=2
POOL_TIMEOUT=5
POOL_RECYCLE=300
MAX_OVERFLOW=2

# Redis — disabled for tests
REDIS_URL=
CACHE_ENABLED=false

# Security — test-only secret
JWT_SECRET_KEY=test-only-secret-key-not-for-production-32chars

# File Storage — local temp directory for tests
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/test_files

# Disable demo data seeding in tests
SEED_DEMO_DATA=false

# Disable config validation for test cold starts
DISABLE_CONFIG_VALIDATION=true

# Test markers
PYTEST_RUNNING=true
